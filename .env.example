# Copy this file to .env  (cp .env.example .env)

# Secret used to sign and verify JWTs. Use a long random string in production.
ACCESS_SECRET=dev-super-secret-change-me

# The one browser origin allowed to call this API (Module 5 production CORS).
CORS_ORIGIN=http://localhost:5173

# Where Redis is running.
REDIS_URL=redis://localhost:6379

# Port the API listens on.
PORT=3000
